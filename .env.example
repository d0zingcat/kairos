# Kairos Environment Variables
# Copy this file to .env and fill in your values

# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://kairos:kairos@localhost:5432/kairos

# ── Auth ──────────────────────────────────────────────────
# Generate with:
# bun -e "import { hash } from 'bcryptjs'; console.log(await hash('your-password', 10))"
# NOTE: escape `$` in .env values, e.g. \$2b\$10\$...
ADMIN_PASSWORD_HASH=\$2a\$10\$xxxxx
# Optional for password-protected mode; if omitted, fallback to ADMIN_PASSWORD_HASH
VIEWER_PASSWORD_HASH=\$2a\$10\$xxxxx
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
# Default mode fallback before DB settings are initialized
SITE_VISIBILITY=private

# ── Logging ──────────────────────────────────────────────
# debug | info | warn | error (default: debug in dev, info in prod)
LOG_LEVEL=debug

# ── Third-party APIs ─────────────────────────────────────
# TMDB (https://www.themoviedb.org/settings/api)
TMDB_API_KEY=

# Google Books (https://console.cloud.google.com)
GOOGLE_BOOKS_API_KEY=

# Hardcover (https://hardcover.app/account/api)
# GraphQL token used on backend only (recommended for better Chinese book search)
HARDCOVER_API_TOKEN=

# RAWG (https://rawg.io/apidocs)
RAWG_API_KEY=

# Last.fm (https://www.last.fm/api/account/create)
LASTFM_API_KEY=
