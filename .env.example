# Kairos Environment Variables
# Copy this file to .env and fill in your values

# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://kairos:kairos@localhost:5432/kairos
# Auto-run migration at app startup (set false to disable)
DB_AUTO_MIGRATE=true

# ── Redis (optional) ────────────────────────────────────────
# Cache layer for API responses (defaults to redis://localhost:6379)
REDIS_URL=redis://localhost:6379

# ── Auth ──────────────────────────────────────────────────
# Generate with:
# bun -e "import { hash } from 'bcryptjs'; console.log(await hash('your-password', 10))"
# NOTE: escape `$` in .env values, e.g. \$2b\$10\$...
ADMIN_PASSWORD_HASH=\$2a\$10\$xxxxx
# Optional for password-protected mode; if omitted, fallback to ADMIN_PASSWORD_HASH
VIEWER_PASSWORD_HASH=\$2a\$10\$xxxxx
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
# Default mode fallback before DB settings are initialized
SITE_VISIBILITY=private

# ── Logging ──────────────────────────────────────────────
# debug | info | warn | error (default: debug in dev, info in prod)
LOG_LEVEL=debug

# ── Third-party APIs ─────────────────────────────────────
# TMDB (https://www.themoviedb.org/settings/api)
TMDB_API_KEY=

# Hardcover (https://hardcover.app/account/api)
# GraphQL token used on backend only (recommended for better Chinese book search)
HARDCOVER_API_TOKEN=

# RAWG (https://rawg.io/apidocs)
RAWG_API_KEY=

# Spotify (https://developer.spotify.com/dashboard)
# Client ID and Secret for OAuth client credentials flow
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# OpenAI (https://platform.openai.com/api-keys)
# Used for content moderation of plaza entries (notes field)
# If not set, moderation is skipped and all content is allowed through
OPENAI_API_KEY=

# ── Search Sources ───────────────────────────────────────
# Comma-separated list of music search sources: spotify, musicbrainz
# Examples: "spotify" (Spotify only), "spotify,musicbrainz" (both, default)
MUSIC_SEARCH_SOURCES=spotify,musicbrainz

# ── Feature Flags ────────────────────────────────────────
NEXT_PUBLIC_GITHUB_URL=https://github.com/d0zingcat/kairos
NEXT_PUBLIC_SITE_AUTHOR=d0zingcat

# ── Version Check ────────────────────────────────────────
# GitHub repository for update checks (format: owner/repo)
NEXT_PUBLIC_GITHUB_REPO=d0zingcat/kairos
# Optional server-side token for private repositories
# GITHUB_TOKEN=ghp_xxx
# Note: Version is automatically read from package.json
